				{
					"name": "GET /api/users/:userId — 401 sin sesión",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Borra la cookie de sesión para forzar el 401",
									"pm.cookies.jar().clear('localhost', function(err) {",
									"    if (err) console.warn('No se pudo limpiar cookies:', err);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:3000/api/users/{{userId}}",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "3000",
							"path": [
								"api",
								"users",
								"{{userId}}"
							]
						},
						"description": "Sin cookie de sesión → 401 NOT_AUTHENTICATED.\n\nEl pre-request script limpia la cookie `session` antes de enviar la petición."
					},
					"response": []
				},
