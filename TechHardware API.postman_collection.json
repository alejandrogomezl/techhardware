		{
			"name": "Auth",
			"item": [
				{
					"name": "POST /api/auth/signin — 200 credenciales válidas",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    const body = pm.response.json();",
									"    pm.collectionVariables.set('userId', body._id);",
									"    console.log('userId guardado:', body._id);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"johndoe@example.com\",\n  \"password\": \"1234\"\n}"
						},
						"url": {
							"raw": "http://localhost:3000/api/auth/signin",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "3000",
							"path": [
								"api",
								"auth",
								"signin"
							]
						},
						"description": "Autentica al usuario y crea la cookie de sesión.\n\n**Test script:** guarda automáticamente el `_id` devuelto en la variable de colección `userId`."
					},
					"response": []
				},
